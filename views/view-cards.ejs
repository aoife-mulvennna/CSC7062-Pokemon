<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Cards</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css"
        integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
</head>
<body>
  <nav class="demo">
    <a href="/" class="brand">
      <span>   <img class="logo" src="<%=logoPath %>" alt="logo"></span>
    </a>
  
  

    <nav class="navbar navbar-default">
        <ul class="nav nav-tabs">
            <li><button type="button" class="btn btn active"><a href="home.html">Home</a></button></li>
            <li><button type="button" class="btn btn"><a href="guest-view-cards.html">View Cards</a></button></li>
            <li><button type="button" class="btn btn"><a href="guest-about.html">About</a></button></li>
            <li><button type="button" class="btn btn"><a href="/pages/sign-up.html">Create an Account</a></button></li>
            <li><button type="button" class="btn btn"><a href="/pages/login.html">Login to Account</a></button></li>
        </ul>
    </nav>
  </nav>
  
  </div>
  <div style="width:80%; margin: 0 auto; padding-top: 100px;">
    <h2><%= titletext %></h2>
    
    <h3>View Pokemon Cards...</h3>

     <div class="flex one two-600 three-800 four-1000"> 

  
        <% bdata['data'].forEach( (pokemon)=>{   %>
            <div>
                <header><%= pokemon.name %></header>
                <p><%=pokemon.type%></p>
             <p><%=pokemon.rarity%></p>
             <a class="button" href="/details?card=<%=pokemon.id%>">details</a>
            </div>
        <% }); %>



    </div>
  </div>
</body>
</html>