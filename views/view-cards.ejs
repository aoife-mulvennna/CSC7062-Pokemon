<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Cards</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css"
    integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/innerstyle.css">
</head>

<body>
  <%-include ('navbar')%>

  <div class="container mt-5">
    <h2>All Cards</h2>
    <hr>
    <% cards.forEach(card=> { %>
    <div class="row">
      <div class="col">
        <img src="<%= card.url_img %>" alt="<%= card.pokemon_name %>" width="210">
      </div>
      <div class="col">
        <ul class="list-unstyled card-details">
          <li><strong class="title">Name:          </strong><%= card.pokemon_name %></li>
          <li><strong class="title">Type:          </strong><%= card.pokemon_type_name %></li>
          <li><strong class="title">Hp:            </strong><%= card.hp %></li>
          <li><strong class="title">Stage:         </strong><%= card.pokemon_stage_name %></li>
          <li><strong class="title">Attack:        </strong><%= card.attack %></li>
          <li><strong class="title">Rarity:        </strong><%= card.rarity_name %></li>
          <li><strong class="title">Weakness:      </strong><%= card.weakness %></li>
          <li><strong class="title">Set:           </strong> <%= card.pokemon_set_name %></li>
          <li><strong class="title">Evolves from:  </strong> <%= card.evolve_from || 'None' %></li>
        </ul>
      </div>
      <!-- <div class="col">
        <ul class="list-unstyled card-details">
         
        </ul>
      </div> -->
      <div class="col">
       
        <form action="/add-to-wishlist" method="POST">
          <input type="hidden" name="card_id" value="<%= card.pokemon_card_id %>">
          <button type="submit" class="btn btn-secondary mt-3">Add to Wishlist</button>
    
        </form>

        <form action="/add-to-collection" method="POST">
          <input type="hidden" name="card_id" value="<%= card.pokemon_card_id %>">
          <button type="submit" class="btn btn-primary mt-3">Add to Collection</button>
    
        </form>
      </div>
    </div>
      <hr>
      <% }); %>
  </div>


  <%-include ('footer')%>
</body>
<link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

</html>