<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Cards</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css"
    integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/innerstyle.css">
</head>

<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">
        <img class="logo" src="<%=logoPath %>" alt="logo">
      </a>
      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <a class="nav-link" aria-current="page" href="home">Home</a>
          <a class="nav-link active" href="view-cards">Browse Cards</a>
          <a class="nav-link" href="other-collections">Browse Collections</a>
          <a class="nav-link" href="view-collection">View My Collection</a>

        </div>
      </div>
      <div class="navbar-nav ml-auto d-flex align-items-center">
        <div>
            <p class="text-white mb-0">You are logged in as <%=username%>!</p>
            <p class="text-white mb-0"><a class="text-white" href="view-account">View My Account</a></p>
        </div>
        <img class="display-profile-pic ml-3" src="<%=picUrl%>" alt="Profile Picture">
    </div>
    </div>
  </nav
 

  <div class="container mt-5">
    <h2>All Cards</h2>
    <hr>
    <% cards.forEach(card=> { %>
    <div class="row">
      <div class="col">
        <img src="<%= card.url_img %>" alt="<%= card.pokemon_name %>" width="210">
      </div>
      <div class="col">
        <ul class="list-unstyled card-details">
          <li><strong class="title">Name:          </strong><%= card.pokemon_name %></li>
          <li><strong class="title">Type:          </strong><%= card.pokemon_type_name %></li>
          <li><strong class="title">Hp:            </strong><%= card.hp %></li>
          <li><strong class="title">Stage:         </strong><%= card.pokemon_stage_name %></li>
          <li><strong class="title">Attack:        </strong><%= card.attack %></li>
          <li><strong class="title">Rarity:        </strong><%= card.rarity_name %></li>
          <li><strong class="title">Weakness:      </strong><%= card.weakness %></li>
          <li><strong class="title">Set:           </strong> <%= card.pokemon_set_name %></li>
          <li><strong class="title">Evolves from:  </strong> <%= card.evolve_from || 'None' %></li>
        </ul>
      </div>
      <!-- <div class="col">
        <ul class="list-unstyled card-details">
         
        </ul>
      </div> -->
      <div class="col">
        <button type="button" class="btn btn-secondary mt-3">Favourite</button></td>
        <form action="/add-to-collection" method="POST">
          <input type="hidden" name="card_id" value="<%= card.pokemon_card_id %>">
          <button type="submit" class="btn btn-primary mt-3">Add to Collection</button>
    
        </form>
      </div>
    </div>
      <hr>
      <% }); %>
  </div>

</body>

</html>