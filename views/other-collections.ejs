<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Cards</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css"
        integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/innerstyle.css">
</head>

<body>

<%-include ('navbar')%>

    <div class="container mt-5">
        <h1>All Collections</h1>

        <hr>
        <% collections.forEach(collection=> { %>
            <div class="row">
                <div class="col">
                    <img src="<%= collection.profile_picture_url %>" class="display-profile-pic">
                <strong><%= collection.username %></strong>'s collection
                </div>
                <div class="col">
                    <ul class="list-unstyled">
    
                        <li>Contains <%= collection.num_cards %> cards </li>
    
                    </ul>
                </div>
                <div class="col">
                    <form action="/view-card-in-collection" method="GET">
                        <input type="hidden" name="collection_id" value="<%= collection.collection_id %>">
                        <button type="submit" class="btn btn-primary mt-3">View Collection</button>
                      </form>
                </div>
                <div class="col">
                    Average rating: <%=collection.average_rating || 'Not rated yet'%>
                </div>
            </div>
           


            <hr>
            <% }); %>


    </div>

</body>

</html>