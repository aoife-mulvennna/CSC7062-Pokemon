<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tradecard | <%=collectionName%></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/innerstyle.css">
</head>

<body>

   <%-include ('navbar') %>

    <div class="container mt-5 view-container">
        <h3><%=collectionName%></h3>
        <h5> Author: <%=userdata.username %></h5>

        <hr>

        <% if (cards.length === 0) { %>
            <div class="container mt-3">
                <div><img class="ml-3 sad" src="sad_eevee.jpeg">
                </div>
               <p>Your collection is empty.</p> 
                <p>Add to your collection by viewing all of the cards!</p>
                <button href="view-cards" class="btn btn-primary mt-3">Browse Cards</button>
                </div>
        <% } else { %>

        <% cards.forEach(card=> { %>
            <div class="row">
                <div class="col">
                    <img src="<%= card.url_img %>" alt="<%= card.pokemon_name %>" width="210">
                </div>
                <div class="col">
                    <ul class="list-unstyled card-details">
                        <li><strong class="title">Name: </strong>
                            <%= card.pokemon_name %>
                        </li>
                        <li><strong class="title">Type: </strong>
                            <%= card.pokemon_type_name %>
                        </li>
                        <li><strong class="title">Hp: </strong>
                            <%= card.hp %>
                        </li>
                        <li><strong class="title">Stage: </strong>
                            <%= card.pokemon_stage_name %>
                        </li>
                        <li><strong class="title">Attack: </strong>
                            <%= card.attack %>
                        </li>
                        <li><strong class="title">Rarity: </strong>
                            <%= card.rarity_name %>
                        </li>
                        <li><strong class="title">Weakness: </strong>
                            <%= card.weakness %>
                        </li>
                        <li><strong class="title">Set: </strong>
                            <%= card.pokemon_set_name %>
                        </li>
                        <li><strong class="title">Evolves from: </strong>
                            <%= card.evolve_from || 'None' %>
                        </li>
                    </ul>
                </div>

                <div class="col">
                    <button type="button" class="btn btn-secondary mt-3">Favourite</button></td>
                    <form action="/remove-from-collection" method="POST">
                        <input type="hidden" name="card_id" value="<%= card.pokemon_card_id %>">
                        <button type="submit" class="btn btn-primary mt-3">Remove</button>
                    </form>
                </div>
            </div>

            <hr>
            <% }); %>
   <% } %>

    </div>
    <%-include ('footer')%>
</body>

</html>