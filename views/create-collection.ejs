<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pokemon TCG - Home</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/innerstyle.css">
</head>

<body>
    <%- include ('navbar') %>
        <div class="container mt-5 mb-5 text-center">
            <h2>Create a new collection!</h2>
            <form action="/create-collection" method="post">
                <div class="mb-3">
                    <label for="email">Collection Name:</label>
                    <input class="w-50" type="text" name="collectionNameField" placeholder="Enter a name for your collection" required>
                </div>
            </form>
            <button class="btn btn-primary" type="submit">Create Collection</button>
        </div>
        <%-include('footer')%>
</body>

</html>