              </svg>Browse Cards</a>
            <a class="nav-link <%= currentPage === '/sign-up' ? 'active' : '' %>" href="sign-up">Create an Account</a>
            <a class="nav-link <%= currentPage === '/login' ? 'active' : '' %>" href="login">Login to Account</a>

        </div>
      </div>
      <div class="navbar-nav ml-auto d-flex align-items-center">
        <div>
          <p class="text-white mb-0">You are logged in as a guest!</p>
        </div>
        <img class="display-profile-pic ml-3" src="Poke_Ball.webp" alt="Profile Picture">
      </div>

      <% } else { %>
        <a class="nav-link <%= currentPage === '/home' ? 'active' : '' %>" href="home"><svg
            xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-house-door"
            viewBox="0 0 20 20">
            <path
              d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4z" />
          </svg>Home</a>
