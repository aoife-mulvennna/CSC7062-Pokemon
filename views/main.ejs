<!DOCTYPE html>
<html lang="en">

<!-- This page is the index page which contains buttons to log in, sign up or enter the web page as a guest -->

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/mystyle.css">

    <title>Pokemon Trading Card Game</title>
</head>


<body>
    <div class="position-relative w-100 vh-100">

        <div class="position-absolute top-50 start-50 translate-middle w-50">
            <div class="border bg-warning rounded text-center w-100 pt-3">

                <img class="logo" src="<%=logoPath %>" alt="logo">

                <div class="container start-50">
                    <h4 class="text-center">
                        Welcome to the pokemon trading game!
                    </h4>
                </div>

                <!-- <p class="font-weight-bold">
                What would you like to do?
            </p> -->
                <p>
                    <a href="/login" class="btn btn text-white bg-primary">Login</a>

                    <a href="/sign-up" class="btn btn text-white bg-primary">Create Account</a>
                </p>
                <p>
                    <a href="/guest-access" class="btn btn text-white bg-secondary">Enter as Guest</a>
                </p>


            </div>
        </div>
    </div>

</body>

</html>