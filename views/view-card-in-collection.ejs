<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tradecard | <%=collectionName%></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/innerstyle.css">
</head>

<body>
    <%-include ('navbar')%>
        <div class="container mt-5 view-container">
            <h2>
                <img src="<%=ownerPic%>" class="display-profile-pic">
                <p>
                <p>
                    <%=collectionName%> by <%=ownerUsername%>
                </p>
            </h2>


            <form action="/ratings" method="POST">
                <input type="hidden" name="collectionId" value="<%= collectionId %>">
                <label for="rating">Rate this collection:</label>
                <select name="ratingValue" id="rating">
                    <option value="1">1 star</option>
                    <option value="2">2 stars</option>
                    <option value="3">3 stars</option>
                    <option value="4">4 stars</option>
                    <option value="5">5 stars</option>
                </select>
                <button type="submit" class="btn btn-primary">Submit Rating</button>
            </form>
            <!-- Display the current rating value -->
            <p>Your current rating: <%= userRating || 'Not rated yet' %> stars
            </p>


            <hr>
            <% if (cardCollectionResults.length===0){ %>
                <p>This collection is empty.</p>

                <% } else { %>

                    <% cards.forEach(card=> { %>
                        <div class="row">
                            <div class="col">
                                <img src="<%= card.url_img %>" alt="<%= card.pokemon_name %>" width="210">
                            </div>
                            <div class="col">
                                <ul class="list-unstyled card-details">
                                    <li><strong class="title">Name: </strong>
                                        <%= card.pokemon_name %>
                                    </li>
                                    <li><strong class="title">Type: </strong>
                                        <%= card.pokemon_type_name %>
                                    </li>
                                    <li><strong class="title">Hp: </strong>
                                        <%= card.hp %>
                                    </li>
                                    <li><strong class="title">Stage: </strong>
                                        <%= card.pokemon_stage_name %>
                                    </li>
                                    <li><strong class="title">Rarity: </strong>
                                        <%= card.rarity_name %>
                                    </li>
                                    <li><strong class="title">Set: </strong>
                                        <%= card.pokemon_set_name %>
                                    </li>

                                    <% if (card.evolve_from !=null && card.evolve_from !==undefined){%>
                                        <li><strong class="title">Evolves from: </strong>
                                            <%= card.evolve_from %>
                                        </li>
                                        <%}%>

                                            <li><strong class="title">Top Attack: </strong>
                                                <%= card.attack_name %>        
                                             
                                                <% if (card.attack_description !=null && card.attack_description !==undefined){%>
                                                       |      <%= card.attack_description %>
                                                  <%}%>
                                                <% if (card.attack_damage !=null && card.attack_damage !==undefined){%>
                                                         |      Damage:  <%= card.attack_damage %>
                                                    <%}%>
                                            </li>
                                            <li><strong class="title">Weakness: </strong>
                                                <%= card.weakness_type%> <%= card.weakness_strength%> 
                                            </li>
                                </ul>
                            </div>
                            <% if (!isOwner) { %>
                                <div class="col">
                                    <form action="/add-to-wishlist" method="POST">
                                        <input type="hidden" name="card_id" value="<%= card.pokemon_card_id %>">
                                        <button type="submit" class="btn btn-secondary mt-3">Add to wishlist</button>
                                    </form>
                                </div>
                                <%} else {%>
                                    <div class="col">
                                        <form action="/remove-from-collection" method="POST">
                                            <input type="hidden" name="card_id" value="<%= card.pokemon_card_id %>">
                                            <input type="hidden" name="collection_id" value="<%= collectionId %>">
                                            <button type="submit" class="btn btn-secondary mt-3">Remove from
                                                Collection</button>
                                        </form>
                                    </div>

                                    <%}%>

                        </div>
                        <hr>
                        <% }); %>
                            <% } %>


        </div>

        <script>
            const ratings = document.getElementById('rating1'); const rating1 = new CDB.Rating(ratings);
            rating1.getRating;
        </script>
        <%-include ('footer')%>
</body>

</html>