<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Collections</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css"
        integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/innerstyle.css">
</head>

<body>

   <%-include ('navbar') %>

    <div class="container mt-5">
        <h2>
            <%=username %>'s collections!
        </h2>

        <hr>

        <% if (collections.length === 0) { %>
            <div class="container mt-3">
                <div><img class="ml-3 sad" src="sad_eevee.jpeg">
                </div>
               <p>Your have no collections!.</p> 
                <p>Create a collection!</p>
                <div class="col">
                    <form action="/create-collection" method="GET">

                        <button type="submit" class="btn btn-primary mt-3">Create a collection</button>
                      </form>
                </div>
 >
                </div>
        <% } else { %>
            <div class="col">
                <form action="/create-collection" method="GET">

                    <button type="submit" class="btn btn-primary mt-3">Create a new collection</button>
                  </form>
            </div>
            <% collections.forEach(collection=> { %>
                <div class="row">
                    <div class="col">
                        <%=collection.collection_name%>
                    </div>
                    <div class="col">
                        <ul class="list-unstyled">
                            <li>Contains <%= collection.num_cards %> cards </li>
                        </ul>
                    </div>
                    <div class="col">
                        <form action="/view-card-in-collection" method="GET">
                            <input type="hidden" name="collection_id" value="<%= collection.collection_id %>">
                            <button type="submit" class="btn btn-primary mt-3">View Collection</button>
                          </form>
                    </div>
                    <div class="col">
                        Average rating: <%=collection.average_rating || 'Not rated yet'%>
                    </div>
                </div>
               
                <hr>
                <% }); %>
   <% } %>

    </div>
    <%-include ('footer')%>
</body>

</html>