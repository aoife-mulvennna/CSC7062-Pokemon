<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tradecard | My Collections</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/innerstyle.css">
</head>

<body>

   <%-include ('navbar') %>
    <div class="container mt-5 view-container">
        <h2>
            <%=userdata.username %>'s collections!
        </h2>

        <hr>

        <% if (collections.length === 0) { %>
            <div class="container mt-3">
                <div><img class="ml-3 sad" src="sad_eevee.jpeg">
                </div>
               <p>Your have no collections!.</p> 
                <p>Create a collection!</p>
                <div class="col">
                    <form action="/create-collection" method="GET">
                        <button type="submit" class="btn btn-primary mt-3"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-square" viewBox="0 0 16 16">
                            <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/>
                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                          </svg>Create a collection</button>
                      </form>
                </div>
 >
                </div>
        <% } else { %>
            <div class="col">
                <form action="/create-collection" method="GET">
                    <button type="submit" class="btn btn-primary m-3">Create a new collection</button>
                  </form>
            </div>
            <hr>
            <% collections.forEach(collection=> { %>
                <div class="row">
                    <div class="col">
                        <%=collection.collection_name%>
                    </div>
                    <div class="col">
                        <ul class="list-unstyled">
                            <li>Contains <%= collection.num_cards %> cards </li>
                        </ul>
                    </div>
                    <div class="col">
                        <form action="/view-card-in-collection" method="GET">
                            <input type="hidden" name="collection_id" value="<%= collection.collection_id %>">
                            <button type="submit" class="btn btn-primary mt-3">View Collection</button>
                          </form>
                    </div>
                    <div class="col">
                        Average rating: <%=collection.average_rating || 'Not rated yet'%>
                    </div>
                </div>
               
                <hr>
                <% }); %>
   <% } %>

    </div>
    <%-include ('footer')%>
</body>

</html>