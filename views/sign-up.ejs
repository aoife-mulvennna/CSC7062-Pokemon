<!DOCTYPE html>
<!-- This page is the sign up page where user enters email, password, username, date of birth. There is a back button and also a log in button if they already have an account -->
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/mystyle.css">

    <title>Pokémon | Sign Up</title>

</head>

<body>


    <div class="position-relative w-100 vh-100">

        <div class="position-absolute top-50 start-50 translate-middle w-50 ">

            <div class="border bg-warning rounded text-center w-100 p-3">

                <img class="logo pb-2" src="<%=logoPath %>" alt="logo">


                <h2>Create your account</h2>

                <form action="/sign-up" method="post">
                    <div class="mb-3">
                        <!-- <label for="email">Email Address:</label> -->
                        <input type="text" name="emailField" placeholder="Enter your Email Address" required>
                    </div>
                    <div class="mb-3">

                        <!-- <label for="username">Username:</label> -->
                        <input type="text" name="usernameField" placeholder="Enter a Username" required>
                    </div>
                    <div class="mb-3">
                        <input type="number" name="ageField" placeholder="Enter your age" required>
                    </div>
                    <div class="mb-3">
                        <!-- <label for="password">Password:</label> -->
                        <input type="password" name="passwordField" placeholder="Create a Password" required>
                    </div>
                    <!-- <div>
                        <label for="profilePicId">Select Profile Picture:</label>
                        <% profilePictures.forEach(profilePic => { %>
                            <button type="submit" name="profilePicId" value="<%= profilePic.profile_picture_id %>">
                              <img src="<%= profilePic.profile_picture_url %>" alt="Profile Picture <%= profilePic.profile_picture_id %>" class="img-thumbnail img-fluid" style="height: 95px">
                            </button>
                          <% }); %>
                        </select>
                    </div> -->
                    <div class="profile-picture-container">
                        <label for="profilePicId">Select Profile Picture:</label>
                        <div class="profile-picture-row">
                            <% profilePictures.slice(0, 3).forEach(profilePic=> { %>
                                <button type="button" class="profile-pic-btn"
                                    value="<%= profilePic.profile_picture_id %>">
                                    <img src="<%= profilePic.profile_picture_url %>"
                                        alt="Profile Picture <%= profilePic.profile_picture_id %>"
                                        class="img-thumbnail img-fluid">
                                </button>
                                <% }); %>
                        </div>
                        <input type="hidden" id="selected-profile-pic" name="profilePicIdField">
                        <!-- <input type="hidden" id="selected-profile-pic" name="profilePicId"> -->
                        <div class="profile-picture-row">
                            <% profilePictures.slice(3).forEach(profilePic=> { %>
                                <button type="button" class="profile-pic-btn"
                                    value="<%= profilePic.profile_picture_id %>">
                                    <img src="<%= profilePic.profile_picture_url %>"
                                        alt="Profile Picture <%= profilePic.profile_picture_id %>"
                                        class="img-thumbnail img-fluid">
                                </button>
                                <% }); %>
                        </div>
                        <input type="hidden" id="selected-profile-pic" name="profilePicIdField">

                    </div>

                    <button type="submit">Create Account</button>

            </div>

            </form>
        </div>
    </div>

    document.addEventListener('DOMContentLoaded', () => {
        const profilePicButtons = document.querySelectorAll('.profile-pic-btn');
        const selectedProfilePicInput = document.getElementById('selected-profile-pic');
    
        profilePicButtons.forEach(button => {
            button.addEventListener('click', () => {
                const profilePicId = button.value;
                console.log('Profile picture ID:', profilePicId); // Check if profilePicId is correct
                selectedProfilePicInput.value = profilePicId;
                console.log('Hidden input value:', selectedProfilePicInput.value); // Check if hidden input value is updated
            });
        });
    });
    

</body>

</html>