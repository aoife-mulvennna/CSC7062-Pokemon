<body>

  <%-include ('navbar')%>

    <div class="container mt-5">

      <h2>All Cards</h2>
      <hr>
      <h4>Filter:</h4>
      <div class="row">
        <div class="col">
          <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1"
              data-bs-toggle="dropdown" aria-expanded="false">
              Sort By
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
              <li><a class="dropdown-item" href="#">Card Name (A-Z)</a></li>
              <li><a class="dropdown-item" href="#">Card Name (Z-A)</a></li>
              <li><a class="dropdown-item" href="#">Rarity (desc)</a></li>
              <li><a class="dropdown-item" href="#">Rarity (asc)</a></li>
            </ul>
          </div>
        </div>
        <div class="col">
          <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1"
              data-bs-toggle="dropdown" aria-expanded="false">
              Stage
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
              <% stageResults.forEach((stage)=> { %>
                <li><a class="dropdown-item" href="#">
                    <%=stage.pokemon_stage_name%>
                  </a></li>
                <% }); %>
            </ul>
          </div>
        </div>

        <div class="col">
          <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1"
              data-bs-toggle="dropdown" aria-expanded="false">
              Rarity
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
              <% rarityResults.forEach((rarity)=> { %>
                <li><a class="dropdown-item" href="#">
                    <%=rarity.rarity_name%>
                  </a></li>
                <% }); %>
            </ul>
          </div>
        </div>

        <div class="col">
          <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1"
              data-bs-toggle="dropdown" aria-expanded="false">
              Type
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
              <% typeResults.forEach((type)=> { %>
                <li><a class="dropdown-item" href="#">
                    <%=type.pokemon_type_name%>
                  </a></li>
                <% }); %>
            </ul>
          </div>
        </div>

        <div class="col">
          <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton1"
              data-bs-toggle="dropdown" aria-expanded="false">
              Set
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
              <% setResults.forEach((set)=> { %>
                <li><a class="dropdown-item" href="#">
                    <%=set.pokemon_set_name%>
                  </a></li>
                <% }); %>
            </ul>
          </div>
        </div>
      </div>




