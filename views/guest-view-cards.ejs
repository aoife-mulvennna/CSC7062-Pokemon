<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Cards</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css"
    integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
</head>

<body>

  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">
        <img class="logo" src="<%=logoPath %>" alt="logo">
      </a>
      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <a class="nav-link" aria-current="page" href="guest-access">Home</a>
          <a class="nav-link active" href="guest-view-cards">Browse Cards</a>
          <a class="nav-link" href="sign-up">Create an Account</a>
          <a class="nav-link" href="login">Login to Account</a>

        </div>
      </div>
    </div>
  </nav>
  <h1>Pokemon Cards</h1>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Image</th>
        <th>HP</th>
        <th>Stage</th>
        <th>Attack</th>
        <th>Rarity</th>
        <th>Weakness</th>
        <th>Set Name</th>
        <th>Evolves From</th>
      </tr>
    </thead>
    <tbody>
      <% cards.forEach(card=> { %>
        <tr>
          <td>
            <%= card.pokemon_name %>
          </td>
          <td>
            <%= card.pokemon_type_name %>
          </td>
          <td><img src="<%= card.url_img %>" alt="<%= card.pokemon_name %>" width="125"></td>
          <td>
            <%= card.hp %>
          </td>
          <td>
            <%= card.pokemon_stage_name %>
          </td>
          <td>
            <%= card.attack %>
          </td>
          <td>
            <%= card.rarity %>
          </td>
          <td>
            <%= card.weakness %>
          </td>
          <td>
            <%= card.pokemon_set_name %>
          </td>
          <td>
            <%= card.evolve_from || '-' %>
          </td>
     
            
      
          </td>
        </tr>
        <% }); %>
    </tbody>
  </table>



</body>

</html>