<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Cards</title>
  <!-- <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css"
    integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous"> -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
  <link rel="stylesheet" type="text/css" href="/innerstyle.css">
</head>

<body>

  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">
        <img class="logo" src="<%=logoPath %>" alt="logo">
      </a>
      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <a class="nav-link" aria-current="page" href="guest-access">Home</a>
          <a class="nav-link active" href="guest-view-cards">Browse Cards</a>
          <a class="nav-link" href="sign-up">Create an Account</a>
          <a class="nav-link" href="login">Login to Account</a>
        </div>
      </div>
      <div class="navbar-nav ml-auto d-flex align-items-center">
        <div>
          <p class="text-white mb-0">You are logged in as a guest!</p>
        </div>
        <img class="display-profile-pic ml-3" src="<%=ballPath%>" alt="Profile Picture">
      </div>
    </div>
  </nav>


  <div class="container mt-5">



    <h2>All Cards</h2>
    <hr>

<!-- <div class="row">
  <div class="col">
Filter by stage
  </div>
  <div class="col">
    Filter by set
  </div>
  <form action="/filter-by-stage" method="GET">
    <input type="hidden" name="stage_name" value="Stage 1">
    <button type="submit" class="btn btn-primary mt-3">Stage 1</button>
  </form>
</div> -->




    <hr>
    <% cards.forEach(card=> { %>
      <div class="row">
        <div class="col">
          <img src="<%= card.url_img %>" alt="<%= card.pokemon_name %>" width="210">
        </div>
        <div class="col">
          <ul class="list-unstyled card-details">
            <li><strong class="title">Name: </strong>
              <%= card.pokemon_name %>
            </li>
            <li><strong class="title">Type: </strong>
              <%= card.pokemon_type_name %>
            </li>
            <li><strong class="title">Hp: </strong>
              <%= card.hp %>
            </li>
            <li><strong class="title">Stage: </strong>
              <%= card.pokemon_stage_name %>
            </li>
            <li><strong class="title">Attack: </strong>
              <%= card.attack %>
            </li>
            <li><strong class="title">Rarity: </strong>
              <%= card.rarity_name %>
            </li>
            <li><strong class="title">Weakness: </strong>
              <%= card.weakness %>
            </li>
            <li><strong class="title">Set: </strong>
              <%= card.pokemon_set_name %>
            </li>
            <li><strong class="title">Evolves from: </strong>
              <%= card.evolve_from || 'None' %>
            </li>
          </ul>
        </div>
        <div class="col">
          Create an account to add to your collection!
        </div>
      </div>

      <hr>
      <% }); %>


  </div>


</body>

</html>