<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pokemon TCG - Home</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css"
        integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/innerstyle.css">
</head>

<body>

    <%- include ('navbar') %>
        <div class="container mt-5">
            <h2> Hello <%=userdata.username %>, welcome! </h2>
            <hr>
            <div class="row">
                <div class="col">
                    <div class="card m-3">
                    
                        <div class="card-body">
                   Welcome to Tradecard, where you can view and save Pokémon cards!
                   You already have an account, so we can get stuck in!
                        </div>
                    </div>
                    <div class="card m-3">
                        <div class="card-header">
                            Member features!
                        </div>
                        <div class="card-body">
                   As a member of the tradecard community, you can:
                   <ul>
                    <li>
                        Browse all of tradecard's available pokémon cards
                    </li>
                    <li>Create as many card collections as you wish</li>
                    <li>Browse other user's collections</li>
                    <li>Rate other user's collections</li>
                    <li>Create a wishlist</li>
                   </ul>
                        </div>
                    </div>
                </div>
                
                <div class="col">
                    <div class="card m-3">
                        <div class="card-header">
                            Card of the Day
                        </div>
                        <div class="card-body">
                            <% if (cardOfTheDay) { %>
                            <h5 class="card-title">
                                <%= cardOfTheDay.pokemon_name %>
                            </h5>
                            <img src="<%= cardOfTheDay.url_img %>" class="card-img-top" alt="<%= cardOfTheDay.pokemon_name %>">
                            <!-- Add other card details here -->
                            <% } else { %>
                            <p>No card of the day available.</p>
                            <% } %>
                        </div>
                    </div>
                    <div class="card m-3">
                        <div class="card-header">
                            More information
                        </div>
                        <div class="card-body">
                            Still more information
                            Still more information
                            Still more information
                            Still more information
                            Still more information
                            Still more information
                            Still more information
                            Still more information
                            Still more information
                            Still more information
                            Still more information
                        </div>
                    </div>
                </div>
                <!-- This section displays some information about the user. If any of these are 0, prompt user to start a collection! -->
                <div class="col">
                    <div class="card m-3">
                        <div class="card-header">
                            My profile!
                        </div>
                        <div class="card-body">
                            <p>Number of collections: </p>
                            <p>You seem to have a favourite pokémon type! </p>
                            <p>Your most saved pokemon set is: </p>
                            <p>Rarirty Score: </p>
         
                        </div>
                    </div>
                    <div class="card m-3">
                        <div class="card-header">
                            How to use tradecard:
                        </div>
                        <div class="card-body">
                          <p>Browse other member collections from the nav bar</p>
                          <p>Use the dropdown to navigate to your user collections and your wishlist</p>
                          <p>Account details can be updated from this dropdown too!</p>
                        </div>
                    </div>
                </div>
            </div>
            
                <%-include ('footer')%>
</body>

</html>