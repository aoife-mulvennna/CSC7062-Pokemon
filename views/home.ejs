<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tradecard | Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/innerstyle.css">
</head>

<body>

    <%- include ('navbar') %>
        <div class="container mt-5 view-container">
            <h2> Hello <%=userdata.username %>, welcome! </h2>
            <hr>
            <div class="row">
                <div class="col">
                    <div class="card m-3">
                    
                        <div class="card-body">
                   Welcome to Tradecard, where you can view and save Pokémon cards!
                   You already have an account, so we can get stuck in!
                        </div>
                    </div>
                    <div class="card m-3">
                        <div class="card-header">
                            Member features!
                        </div>
                        <div class="card-body">
                   As a member of the tradecard community, you can:
                   <ul>
                    <li>
                        Browse all of tradecard's available pokémon cards
                    </li>
                    <li>Create as many card collections as you wish</li>
                    <li>Browse other user's collections</li>
                    <li>Rate other user's collections</li>
                    <li>Create a wishlist</li>
                   </ul>
                        </div>
                    </div>
                    <div class="card m-3">
                        <div class="card-header">
                            How to use tradecard:
                        </div>
                        <div class="card-body">
                          <p>Browse other member collections from the nav bar</p>
                          <p>Use the dropdown to navigate to your user collections and your wishlist</p>
                          <p>Account details can be updated from this dropdown too!</p>
                        </div>
                    </div>
                </div>
             
                <div class="col">
                    <div class="card m-3">
                        <div class="card-header">
                            Card of the Day
                        </div>
                        <div class="card-body">
                            <% if (cardOfTheDay) { %>
                            <h5 class="card-title">
                                <%= cardOfTheDay.pokemon_name %>
                            </h5>
                            <form action="/view-card-details?card_id=<%= cardOfTheDay.card_id %>" method="GET">
                                <input type="hidden" name="card_id" value="<%= cardOfTheDay.card_id%>">
                                <button type="submit" class="btn  mt-3 mb-3">  <img src="<%= cardOfTheDay.url_img %>" class="card-img-top" alt="<%= cardOfTheDay.pokemon_name %>">
                                  </button>
                                </form>
                                
                          
                            <% } else { %>
                            <p>No card of the day available.</p>
                            <% } %>
                        </div>
                    </div>
                    
                </div>
                <!-- This section displays some information about the user. If any of these are 0, prompt user to start a collection! -->
                <div class="col">
                    <div class="card m-3">
                        <div class="card-header">
                            Your Stats:
                        </div>
                        <div class="card-body">
                            <p>Number of collections: <strong><%=numCollections%></strong> </p>
                            <p>You seem to have a favourite pokémon type! <strong><%=mostCommonType%></strong> </p>
                            <p>Your most saved pokemon set is: <strong><%=mostCommonSet%></strong> </p>
                            <p>Rarity Score: <strong><%=rarityScore%></strong> </p>
         
                        </div>
                    </div>

                    <div class="card m-3">
                        <div class="card-header">
                            Rarity Leaderboard
                        </div>
                        <div class="card-body">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Position</th>
                                        <th>User</th>
                                        <th>Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% leaderboard.forEach((user, index) => { %>
                                        <tr>
                                            <td><%=index +1%></td>
                                            <td><%= user.username %></td>
                                            <td><%= user.rarity_score %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                </div>
            </div>
            
           </div>    
</body>
<%-include ('footer')%>

</html>