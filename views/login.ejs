<!DOCTYPE html>
<!-- This page is the log in page which takes the users email address and password. There os also a back button and a button for "no account, sign up" -->
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" type="text/css" href="/mystyle.css">
    <title>Pokemon | Login</title>
</head>

<body>

    <div class="position-relative w-100 vh-100">

        <div class="position-absolute top-50 start-50 translate-middle w-50 ">

            <div class="border bg-warning rounded text-center w-100 p-3">

                <img class="logo pb-2" src="<%=logoPath %>" alt="logo">

                <h4>Enter your username and password.</h4>
               
                <% if(errorMessage !== null ) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= errorMessage %>
                    </div>
                <% } %>

                <form class="login-form" action="/login" method="POST" id="loginForm">
                    <div class="pb-1 pt-3 form-group">
                        <p><input name="usernameField" placeholder="Username" required type="text"
                                class=form-control id="username" </p>
                    </div>
                    <div class="pb-3 form-group">
                        <input name="passwordField" type="password" class="form-control" name="password"
                            placeholder="Password" required>
                    </div>
                    <a href="/" class="btn btn-secondary">
                        Go Back
                    </a>
                    <button type="submit" class="btn btn-success" <a href="/home"></a>Login</button>
                </form>

            </div>



        </div>
    </div>

    </div>

 

</body>

</html>